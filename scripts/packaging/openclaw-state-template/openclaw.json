{
  "meta": {
    "lastTouchedVersion": "2026.3.28",
    "lastTouchedAt": "2026-05-06T05:18:48.302Z"
  },
  "browser": {
    "attachOnly": true,
    "defaultProfile": "openclaw",
    "profiles": {
      "openclaw": {
        "cdpUrl": "http://127.0.0.1:9222",
        "color": "#4285F4"
      }
    }
  },
  "ui": {
    "assistant": {
      "name": "VClaw",
      "avatar": "🦞"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "google": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "api": "google-generative-ai",
        "models": [
          {
            "id": "gemini-3.1-pro-preview",
            "name": "Gemini 3.1 Pro",
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "gemini-3-flash-preview",
            "name": "Gemini 3 Flash",
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek-web/deepseek-chat",
        "fallbacks": [
          "gemini-web/gemini-3-flash"
        ]
      },
      "models": {
        "deepseek-web/deepseek-chat": {
          "alias": "DeepSeek V3"
        },
        "gemini-web/gemini-3-flash": {
          "alias": "Gemini 3 Flash"
        }
      },
      "workspace": "~/.openclaw/workspace",
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "15m"
      }
    }
  },
  "tools": {
    "profile": "full",
    "deny": [
      "web_search",
      "web_fetch",
      "x_search",
      "browser"
    ],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      },
      "x_search": {
        "enabled": false
      }
    },
    "sessions": {
      "visibility": "all"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "bash": false,
    "config": false,
    "mcp": false,
    "plugins": false,
    "debug": false,
    "restart": true,
    "ownerDisplay": "raw",
    "allowFrom": {
      "zalouser": [],
      "zalo": []
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "resetByType": {
      "direct": {
        "mode": "idle",
        "idleMinutes": 240
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": true
        },
        "bootstrap-extra-files": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "zalouser": {
      "enabled": true,
      "dangerouslyAllowNameMatching": false,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "*": {
          "allow": true,
          "requireMention": true
        }
      }
    }
  },
  "gateway": {
    "port": 3001,
    "mode": "local",
    "bind": "custom",
    "customBindHost": "127.0.0.1",
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "62b791625fa441be036acd3c206b7e14e2bb13c803355823"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "vclaw-business": {
        "command": "node",
        "args": [
          "__VCLAW_AGENT_TOOLS_MCP_STDIO__"
        ],
        "env": {
          "VCLAW_AGENT_TOOLS_URL": "http://127.0.0.1:12687/api/vclaw/agent-tools",
          "VCLAW_AGENT_TOOLS_SECRET": "67859bd51900be1751e4b6db3da02f2c2ca81fc3175742e2e0c341e9b56c4570"
        },
        "description": "VClaw Business Tools — stdio MCP bridge vào database/product/order/payment của VClaw UI"
      }
    }
  },
  "plugins": {
    "allow": [
      "browser",
      "recruitment-bridge",
      "zalouser"
    ],
    "entries": {
      "browser": {
        "enabled": true,
        "config": {}
      },
      "recruitment-bridge": {
        "enabled": true,
        "config": {}
      },
      "zalouser": {
        "enabled": true,
        "config": {}
      }
    }
  }
}