#!/bin/bash
# VClaw pkg preinstall — chuẩn bị nâng cấp an toàn
# Script này chạy dưới quyền root. Thông điệp [VClaw] → stderr (Nhật ký cài đặt).
set +e

LOG="/tmp/vclaw-preinstall.log"
log_line() {
  local line="[VClaw][$(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$line" >>"$LOG"
  echo "$line" >&2
}
echo "=== VClaw Preinstall Start $(date) ===" | tee -a "$LOG" >&2

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# Định nghĩa lại các hàm hiển thị cơ bản
ok()   { echo "✓ $*"; }
warn() { echo "! $*"; }
info() { echo "· $*"; }
step() { echo -e "\n== $* =="; }

# Resolve the real logged-in user
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && CONSOLE_USER="$(logname 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
fi

log_line "Preinstall: chuẩn bị nâng cấp an toàn cho user: $CONSOLE_USER"
step "Chuẩn bị nâng cấp an toàn cho user: $CONSOLE_USER"

# Dừng tiến trình đang dùng file app/runtime cũ. Không uninstall gateway/config để giữ dữ liệu.
pkill -TERM -i VClaw 2>/dev/null || true
sleep 1
pkill -9 -i VClaw 2>/dev/null || true

OPENCLAW_STATE_DIR="$USER_HOME/.openclaw"
PORT="${OPENCLAW_GATEWAY_PORT:-3001}"

for PID_FILE in \
  "$OPENCLAW_STATE_DIR/.vclaw-zero-gateway.pid" \
  "$OPENCLAW_STATE_DIR/workspace/.vclaw-zero-gateway.pid"
do
  if [[ -f "$PID_FILE" ]]; then
    OLD_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$OLD_PID" ]]; then
      kill "$OLD_PID" 2>/dev/null || true
      sleep 1
      kill -9 "$OLD_PID" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" 2>/dev/null || true
  fi
done

if command -v lsof &>/dev/null; then
  PORT_PIDS="$(lsof -ti:"$PORT" 2>/dev/null | tr '\n' ' ' || true)"
  if [[ -n "${PORT_PIDS// }" ]]; then
    # shellcheck disable=SC2086
    kill $PORT_PIDS 2>/dev/null || true
    sleep 1
    # shellcheck disable=SC2086
    kill -9 $PORT_PIDS 2>/dev/null || true
  fi
fi

info "Đang xóa ứng dụng cũ..."
rm -rf "/Applications/VClaw.app" 2>/dev/null || true
rm -rf "/Applications/Uninstall-VClaw.app" 2>/dev/null || true
rm -rf "/Applications/Uninstall VClaw.app" 2>/dev/null || true

# Xóa openclaw binary ở mọi vị trí
FINAL_BIN="$(sudo -u "$CONSOLE_USER" which openclaw 2>/dev/null || true)"
[[ -n "$FINAL_BIN" ]] && rm -f "$FINAL_BIN" 2>/dev/null || true
rm -f "/usr/local/bin/openclaw" "/opt/homebrew/bin/openclaw" 2>/dev/null || true
rm -f "$USER_HOME/.local/bin/openclaw" 2>/dev/null || true

# Chỉ xóa artifact có thể tái tạo. Giữ nguyên openclaw.json, workspace, business.sqlite,
# session/auth state và mọi dữ liệu khách hàng để migration của app xử lý khi cần.
info "Đang dọn runtime có thể tái tạo, giữ nguyên dữ liệu khách hàng..."
rm -rf "$USER_HOME/.openclaw/runtime" 2>/dev/null || true
rm -rf "$USER_HOME/.openclaw/bundled-packages" 2>/dev/null || true
rm -rf "$USER_HOME/.openclaw/bundled-plugins" 2>/dev/null || true
rm -f "$USER_HOME/.openclaw/.vclaw-zero-gateway.pid" 2>/dev/null || true
rm -f "$USER_HOME/.openclaw/workspace/.vclaw-zero-gateway.pid" 2>/dev/null || true

ok "Chuẩn bị nâng cấp hoàn thành — dữ liệu người dùng được giữ nguyên"

# ── Bước 2: Kiểm tra Node.js ──────────────────────────────────────────────────
info "Kiểm tra Node.js..."
NODE_OK=false
if command -v node &>/dev/null; then
  VER="$(node -e 'process.stdout.write(process.version)' 2>/dev/null || echo v0)"
  MAJ="$(echo "$VER" | sed 's/v//' | cut -d. -f1)"
  # openclaw.mjs: Node >= 22.12; chấp nhận >= 22, thiếu bản 22+ thì tải v22.14.0
  if [[ "$MAJ" -ge 22 ]]; then
    ok "Node.js $VER"
    NODE_OK=true
  else
    warn "Node.js $VER — OpenClaw cần Node v22+ (sẽ tải v22.14.0 nếu cần)"
  fi
fi

if [[ "$NODE_OK" == "false" ]]; then
  ARCH="$(uname -m)"
  case "$ARCH" in arm64) A="arm64";; x86_64) A="x64";; *) A="";; esac
  if [[ -n "$A" ]]; then
    log_line "Đang tải Node.js v22.14.0 ($A) — có thể vài phút, xem Nhật ký cài đặt…"
    info "Đang tải Node.js v22.14.0 ($A)..."
    if curl -fsSL "https://nodejs.org/dist/v22.14.0/node-v22.14.0-darwin-${A}.tar.gz" \
         -o /tmp/vclaw-node.tar.gz 2>/dev/null; then
      tar -xzf /tmp/vclaw-node.tar.gz -C /usr/local --strip-components=1 2>/dev/null \
        && ok "Node.js v22.14.0 đã cài" \
        || warn "Giải nén Node.js thất bại"
      rm -f /tmp/vclaw-node.tar.gz
    else
      warn "Không tải được Node.js — tự cài tại https://nodejs.org"
    fi
  else
    warn "Kiến trúc $ARCH không hỗ trợ — tự cài Node.js tại https://nodejs.org"
  fi
fi

echo ""
ok "Preinstall hoàn thành"
log_line "Preinstall hoàn thành — nhật ký: $LOG"
exit 0
