#!/usr/bin/env bash
# VClaw pkg preinstall — runs before payload is copied to /Applications
# Keep this script FAST — only check/install Node.js.
# OpenClaw + Ollama are installed in the background by postinstall.
set -uo pipefail

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

BOLD='\033[1m'; OK='\033[38;2;0;229;204m'; WARN='\033[38;2;255;176;32m'; NC='\033[0m'
ok()   { echo -e "${OK}✓${NC} $*"; }
warn() { echo -e "${WARN}!${NC}  $*"; }
info() { echo "·  $*"; }
step() { echo -e "\n${BOLD}$*${NC}"; }

step "[1/1] Node.js"
NODE_OK=false
if command -v node &>/dev/null; then
  VER="$(node -e 'process.stdout.write(process.version)' 2>/dev/null || echo v0)"
  MAJ="$(echo "$VER" | sed 's/v//' | cut -d. -f1)"
  if [[ "$MAJ" -ge 20 ]]; then
    ok "Node.js $VER"
    NODE_OK=true
  else
    warn "Node.js $VER quá cũ — sẽ cài v22"
  fi
fi

if [[ "$NODE_OK" == "false" ]]; then
  ARCH="$(uname -m)"
  case "$ARCH" in arm64) A="arm64";; x86_64) A="x64";; *) A="";; esac
  if [[ -n "$A" ]]; then
    info "Đang tải Node.js v22.14.0 ($A)..."
    if curl -fsSL "https://nodejs.org/dist/v22.14.0/node-v22.14.0-darwin-${A}.tar.gz" \
         -o /tmp/vclaw-node.tar.gz 2>/dev/null; then
      tar -xzf /tmp/vclaw-node.tar.gz -C /usr/local --strip-components=1 2>/dev/null \
        && ok "Node.js v22.14.0 đã cài" \
        || warn "Giải nén Node.js thất bại"
      rm -f /tmp/vclaw-node.tar.gz
    else
      warn "Không tải được Node.js — tự cài tại https://nodejs.org"
    fi
  else
    warn "Kiến trúc $ARCH không hỗ trợ — tự cài Node.js tại https://nodejs.org"
  fi
fi

echo ""
ok "Preinstall hoàn thành"
