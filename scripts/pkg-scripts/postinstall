#!/bin/bash
# VClaw pkg postinstall — OpenClaw Zero Token (runtime từ tarball), mở Terminal chạy vclaw-zero.sh.
# Chạy dưới quyền root. Thông điệp ghi ra stderr → Installer > Nhật ký cài đặt > Hiển thị tất cả.
set +e

LOG="/tmp/vclaw-postinstall.log"
NPM_LOG="/tmp/vclaw-npm-install.log"

# Ghi log file + hiển thị trong cửa sổ Nhật ký cài đặt (stderr)
log_line() {
  local line="[VClaw][$(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$line" >>"$LOG"
  echo "$line" >&2
}

# Thông báo macOS (Notification Center) — không chặn cài đặt
notify_user() {
  local msg="$1"
  local safe
  safe=$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
    return 0
  fi
  if ! command -v osascript &>/dev/null; then
    return 0
  fi
  local uid
  uid="$(id -u "$CONSOLE_USER" 2>/dev/null)" || return 0
  if [[ -n "$uid" && "$uid" != "0" ]]; then
    launchctl asuser "$uid" sudo -u "$CONSOLE_USER" \
      osascript -e "display notification \"$safe\" with title \"VClaw — cài đặt\"" 2>/dev/null \
      || sudo -u "$CONSOLE_USER" osascript -e "display notification \"$safe\" with title \"VClaw — cài đặt\"" 2>/dev/null \
      || true
  fi
}

echo "=== VClaw Postinstall Start $(date) ===" | tee -a "$LOG" >&2

# PATH đầy đủ cho root và cho mọi lệnh sudo (macOS sudo thường bỏ /opt/homebrew/bin).
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
export NPM_CONFIG_PROGRESS="${NPM_CONFIG_PROGRESS:-true}"
# PATH buộc truyền vào subshell user — nếu không, npm/node từ Homebrew không thấy → runtime trống.
SUDO_USER_PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && CONSOLE_USER="$(logname 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
fi

log_line "Bắt đầu hậu cài đặt VClaw (người dùng: ${CONSOLE_USER:-root})"
notify_user "Bắt đầu cài đặt VClaw — cài OpenClaw runtime (có thể vài phút)."

INSTALL_STATUS=0

# ── 1. Cấu hình ban đầu ───────────────────────────────────────────────────────
log_line "[1/3] Chuẩn bị thư mục cấu hình ~/.openclaw"
notify_user "Bước 1/3: Chuẩn bị cấu hình OpenClaw"

CONFIG_DIR="$USER_HOME/.openclaw"
CONFIG_FILE="$CONFIG_DIR/openclaw.json"
DEFAULT_CFG="/Applications/VClaw.app/Contents/Resources/openclaw.default.json"

mkdir -p "$CONFIG_DIR"
if [[ -f "$DEFAULT_CFG" && ! -f "$CONFIG_FILE" ]]; then
  cp "$DEFAULT_CFG" "$CONFIG_FILE"
fi
[[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true

# Seed ~/.openclaw/workspace (bot bán hàng — không ghi đè file đã có)
WS_TPL="/Applications/VClaw.app/Contents/Resources/openclaw-workspace-template"
WS_SYNC="/Applications/VClaw.app/Contents/Resources/sync-openclaw-workspace.sh"
if [[ -d "$WS_TPL" && -f "$WS_SYNC" && -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  chmod +x "$WS_SYNC" 2>/dev/null || true
  if sudo -u "$CONSOLE_USER" -H env HOME="$USER_HOME" bash "$WS_SYNC" --if-missing --template "$WS_TPL" >>"$LOG" 2>&1; then
    log_line "  ✓ Đã đồng bộ workspace bot (~/.openclaw/workspace) từ template VClaw (chỉ file thiếu)"
  else
    log_line "  ! sync-openclaw-workspace: xem $LOG (không chặn cài đặt)"
  fi
  chown -R "$CONSOLE_USER" "$USER_HOME/.openclaw/workspace" 2>/dev/null || true
fi
log_line "  ✓ Thư mục cấu hình đã sẵn sàng"
log_line "  (business.sqlite không copy từ app — tạo lần đầu khi mở VClaw qua migration SQL)"

# ── 2. Cài OpenClaw (gói .tgz kèm app — build từ core/openclaw-zero-token) ───
BUNDLED_OPENCLAW_TGZ="/Applications/VClaw.app/Contents/Resources/openclaw-bundled.tgz"
LOCAL_BUNDLED_PACKAGE_DIR="$CONFIG_DIR/bundled-packages"
LOCAL_BUNDLED_OPENCLAW_TGZ="$LOCAL_BUNDLED_PACKAGE_DIR/openclaw-bundled.tgz"
log_line "[2/3] Đang cài OpenClaw vào ~/.openclaw/runtime từ bản kèm VClaw (local)…"
log_line "  (Chi tiết npm: $NPM_LOG)"
notify_user "Bước 2/3: Đang cài OpenClaw (bản kèm ứng dụng)…"

RUNTIME_DIR="$CONFIG_DIR/runtime"
mkdir -p "$RUNTIME_DIR"

if [[ ! -f "$BUNDLED_OPENCLAW_TGZ" ]]; then
  log_line "  ! Không tìm thấy $BUNDLED_OPENCLAW_TGZ (cần build installer với package-vclaw.sh)."
  notify_user "Lỗi: thiếu gói OpenClaw kèm app. Xem Nhật ký cài đặt."
  INSTALL_STATUS=1
else
  mkdir -p "$LOCAL_BUNDLED_PACKAGE_DIR"
  cp "$BUNDLED_OPENCLAW_TGZ" "$LOCAL_BUNDLED_OPENCLAW_TGZ"
  chmod 0644 "$LOCAL_BUNDLED_OPENCLAW_TGZ" 2>/dev/null || true
  if [[ -n "$CONSOLE_USER" ]]; then
    chown -R "$CONSOLE_USER" "$LOCAL_BUNDLED_PACKAGE_DIR" 2>/dev/null || true
  fi
fi

if [[ ! -f "$LOCAL_BUNDLED_OPENCLAW_TGZ" ]]; then
  INSTALL_STATUS=1
elif [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  chown "$CONSOLE_USER" "$RUNTIME_DIR"
  sudo -u "$CONSOLE_USER" -H env \
    PATH="$SUDO_USER_PATH" \
    NPM_CONFIG_CACHE="$RUNTIME_DIR/.npm-cache" \
    bash -c "
    set -o pipefail
    cd \"$RUNTIME_DIR\"
    mkdir -p .npm-cache
    if [[ ! -f \"package.json\" ]]; then
      echo '{\"name\":\"openclaw-runtime\",\"version\":\"1.0.0\",\"private\":true}' > package.json
    fi
    umask 022
    if ! command -v npm >/dev/null 2>&1; then
      echo \"[VClaw] Lỗi: không tìm thấy npm trong PATH=\$PATH (cần Node 22+; Homebrew: /opt/homebrew/bin).\" | tee -a \"$NPM_LOG\"
      exit 127
    fi
    echo \"[VClaw] npm=\$(command -v npm) node=\$(command -v node)\" | tee -a \"$NPM_LOG\"
    npm install \"$LOCAL_BUNDLED_OPENCLAW_TGZ\" --foreground-scripts --loglevel info 2>&1 | tee -a \"$NPM_LOG\"
  "
  INSTALL_STATUS=$?
  chown -R "$CONSOLE_USER" "$RUNTIME_DIR"
else
  set -o pipefail
  export PATH="$SUDO_USER_PATH"
  mkdir -p "$RUNTIME_DIR/.npm-cache"
  export NPM_CONFIG_CACHE="$RUNTIME_DIR/.npm-cache"
  cd "$RUNTIME_DIR"
  if [[ ! -f "package.json" ]]; then
    echo '{"name":"openclaw-runtime","version":"1.0.0","private":true}' > package.json
  fi
  umask 022
  if ! command -v npm >/dev/null 2>&1; then
    echo "[VClaw] Lỗi: không tìm thấy npm trong PATH=$PATH" | tee -a "$NPM_LOG"
    INSTALL_STATUS=127
  else
    echo "[VClaw] npm=$(command -v npm) node=$(command -v node)" | tee -a "$NPM_LOG"
    npm install "$LOCAL_BUNDLED_OPENCLAW_TGZ" --foreground-scripts --loglevel info 2>&1 | tee -a "$NPM_LOG"
    INSTALL_STATUS=$?
  fi
fi

OPENCLAW_BIN="$RUNTIME_DIR/node_modules/.bin/openclaw"
if [[ $INSTALL_STATUS -eq 0 && -x "$OPENCLAW_BIN" ]]; then
  if ln -sf "$OPENCLAW_BIN" /usr/local/bin/openclaw 2>/dev/null; then
    log_line "  ✓ Symlink: /usr/local/bin/openclaw"
  elif ln -sf "$OPENCLAW_BIN" /opt/homebrew/bin/openclaw 2>/dev/null; then
    log_line "  ✓ Symlink: /opt/homebrew/bin/openclaw"
  else
    mkdir -p "$USER_HOME/.local/bin"
    if ln -sf "$OPENCLAW_BIN" "$USER_HOME/.local/bin/openclaw" 2>/dev/null; then
      [[ -n "$CONSOLE_USER" ]] && chown -h "$CONSOLE_USER" "$USER_HOME/.local/bin/openclaw" 2>/dev/null || true
      log_line "  ✓ Symlink: $USER_HOME/.local/bin/openclaw (đã thêm gợi ý PATH trong vclaw-zero.sh)"
    else
      log_line "  ! Không tạo được symlink openclaw — chạy trực tiếp: $OPENCLAW_BIN"
    fi
  fi
  log_line "  ✓ OpenClaw (bản kèm app) đã cài tại $RUNTIME_DIR."
else
  log_line "  ! Lỗi: npm không cài được openclaw từ gói kèm (mã $INSTALL_STATUS) hoặc thiếu $OPENCLAW_BIN."
  notify_user "Lỗi: không cài được OpenClaw. Xem Nhật ký cài đặt."
fi

# ── 3. Mở Terminal chạy Zero Token (Chrome → webauth → gateway) ───────────────
VCLAW_ZERO="/Applications/VClaw.app/Contents/Resources/vclaw-zero.sh"
log_line "[3/3] Mở Terminal cho luồng Zero Token (vclaw-zero.sh)"
notify_user "Bước 3/3: Mở Terminal — hoàn tất đăng nhập web trong Chrome."

if [[ $INSTALL_STATUS -ne 0 ]]; then
  log_line "  ! Bỏ qua mở Terminal tự động (cài OpenClaw thất bại). Chạy tay sau khi sửa:"
  log_line "    bash $VCLAW_ZERO"
elif [[ ! -f "$VCLAW_ZERO" ]]; then
  log_line "  ! Không thấy $VCLAW_ZERO"
elif [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
  log_line "  ! Không xác định được người dùng console — chạy tay: bash $VCLAW_ZERO"
elif ! command -v osascript &>/dev/null; then
  log_line "  ! Không có osascript — chạy tay: bash $VCLAW_ZERO"
else
  chmod +x "$VCLAW_ZERO" 2>/dev/null || true
  uid="$(id -u "$CONSOLE_USER" 2>/dev/null)" || uid=""
  open_zero_terminal() {
    sudo -u "$CONSOLE_USER" osascript \
      -e 'tell application "Terminal" to do script "bash /Applications/VClaw.app/Contents/Resources/vclaw-zero.sh"' \
      -e 'tell application "Terminal" to activate' 2>/dev/null
  }
  if [[ -n "$uid" && "$uid" != "0" ]]; then
    launchctl asuser "$uid" sudo -u "$CONSOLE_USER" bash -c "osascript -e 'tell application \"Terminal\" to do script \"bash /Applications/VClaw.app/Contents/Resources/vclaw-zero.sh\"' -e 'tell application \"Terminal\" to activate'" 2>/dev/null \
      || open_zero_terminal \
      || log_line "  ! Không mở được Terminal (osascript)."
  else
    open_zero_terminal || log_line "  ! Không mở được Terminal (osascript)."
  fi
  log_line "  ✓ Đã yêu cầu mở Terminal với vclaw-zero.sh (nếu không thấy cửa sổ, chạy tay lệnh trên)."
fi

log_line "=== Hoàn tất postinstall $(date) === Nhật ký: $LOG | npm: $NPM_LOG"
notify_user "VClaw: cài đặt runtime xong. Làm theo cửa sổ Terminal (Zero Token), rồi mở VClaw từ Applications."

exit 0
