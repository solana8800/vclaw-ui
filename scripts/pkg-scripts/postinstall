#!/bin/bash
# VClaw pkg postinstall — OpenClaw + Ollama (có log + thông báo bước cho người dùng)
# Chạy dưới quyền root. Thông điệp ghi ra stderr → Installer > Nhật ký cài đặt > Hiển thị tất cả.
set +e

LOG="/tmp/vclaw-postinstall.log"

# Ghi log file + hiển thị trong cửa sổ Nhật ký cài đặt (stderr)
log_line() {
  local line="[VClaw][$(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$line" >>"$LOG"
  echo "$line" >&2
}

# Thông báo macOS (Notification Center) — không chặn cài đặt
notify_user() {
  local msg="$1"
  local safe
  safe=$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]]; then
    return 0
  fi
  if ! command -v osascript &>/dev/null; then
    return 0
  fi
  local uid
  uid="$(id -u "$CONSOLE_USER" 2>/dev/null)" || return 0
  if [[ -n "$uid" && "$uid" != "0" ]]; then
    launchctl asuser "$uid" sudo -u "$CONSOLE_USER" \
      osascript -e "display notification \"$safe\" with title \"VClaw — cài đặt\"" 2>/dev/null \
      || sudo -u "$CONSOLE_USER" osascript -e "display notification \"$safe\" with title \"VClaw — cài đặt\"" 2>/dev/null \
      || true
  fi
}

echo "=== VClaw Postinstall Start $(date) ===" | tee -a "$LOG" >&2

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
export NPM_CONFIG_PROGRESS="${NPM_CONFIG_PROGRESS:-true}"

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && CONSOLE_USER="$(logname 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
fi

log_line "Bắt đầu hậu cài đặt VClaw (người dùng: ${CONSOLE_USER:-root})"
notify_user "Bắt đầu cài đặt VClaw — các bước OpenClaw/Ollama có thể mất vài phút."

# ── 1. Cấu hình ban đầu ───────────────────────────────────────────────────────
log_line "[1/5] Chuẩn bị thư mục cấu hình ~/.openclaw"
notify_user "Bước 1/5: Chuẩn bị cấu hình OpenClaw"

CONFIG_DIR="$USER_HOME/.openclaw"
CONFIG_FILE="$CONFIG_DIR/openclaw.json"
DEFAULT_CFG="/Applications/VClaw.app/Contents/Resources/openclaw.default.json"

mkdir -p "$CONFIG_DIR"
if [[ -f "$DEFAULT_CFG" && ! -f "$CONFIG_FILE" ]]; then
  cp "$DEFAULT_CFG" "$CONFIG_FILE"
fi
[[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true
log_line "  ✓ Thư mục cấu hình đã sẵn sàng"

# Cài đặt database ban đầu nếu chưa có
BUNDLED_DB="/Applications/VClaw.app/Contents/Resources/app/prisma/business.sqlite"
TARGET_DB="$CONFIG_DIR/business.sqlite"
if [[ -f "$BUNDLED_DB" && ! -f "$TARGET_DB" ]]; then
  cp "$BUNDLED_DB" "$TARGET_DB"
  [[ -n "$CONSOLE_USER" ]] && chown "$CONSOLE_USER" "$TARGET_DB" 2>/dev/null || true
  log_line "  ✓ Đã khởi tạo database doanh nghiệp tại $TARGET_DB"
fi

# ── 2. Cài OpenClaw (gói .tgz kèm app — build từ core/openclaw khi đóng gói) ───
# Phụ thuộc của openclaw vẫn có thể được npm tải từ registry khi cài tarball.
BUNDLED_OPENCLAW_TGZ="/Applications/VClaw.app/Contents/Resources/openclaw-bundled.tgz"
log_line "[2/5] Đang cài OpenClaw vào ~/.openclaw/runtime từ bản kèm VClaw (local)…"
notify_user "Bước 2/5: Đang cài OpenClaw (bản kèm ứng dụng)…"

RUNTIME_DIR="$CONFIG_DIR/runtime"
mkdir -p "$RUNTIME_DIR"

if [[ ! -f "$BUNDLED_OPENCLAW_TGZ" ]]; then
  log_line "  ! Không tìm thấy $BUNDLED_OPENCLAW_TGZ (cần build installer với package-vclaw.sh)."
  notify_user "Lỗi: thiếu gói OpenClaw kèm app. Xem Nhật ký cài đặt."
  INSTALL_STATUS=1
elif [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  chown "$CONSOLE_USER" "$RUNTIME_DIR"
  sudo -u "$CONSOLE_USER" -H bash -c "
    cd \"$RUNTIME_DIR\"
    if [[ ! -f \"package.json\" ]]; then
      echo '{\"name\":\"openclaw-runtime\",\"version\":\"1.0.0\",\"private\":true}' > package.json
    fi
    npm install \"$BUNDLED_OPENCLAW_TGZ\" --foreground-scripts --loglevel info
  "
  INSTALL_STATUS=$?
  # Chỉnh lại quyền một lần nữa cho chắc sau khi npm install
  chown -R "$CONSOLE_USER" "$RUNTIME_DIR"
else
  cd "$RUNTIME_DIR"
  if [[ ! -f "package.json" ]]; then
    echo '{"name":"openclaw-runtime","version":"1.0.0","private":true}' > package.json
  fi
  npm install "$BUNDLED_OPENCLAW_TGZ" --foreground-scripts --loglevel info
  INSTALL_STATUS=$?
fi

if [[ $INSTALL_STATUS -eq 0 ]]; then
  # Link tới /usr/local/bin để lệnh 'openclaw' vẫn dùng được toàn cục
  ln -sf "$RUNTIME_DIR/node_modules/.bin/openclaw" /usr/local/bin/openclaw
  log_line "  ✓ OpenClaw (bản kèm app) đã cài tại $RUNTIME_DIR."
else
  log_line "  ! Lỗi: npm không cài được openclaw từ gói kèm."
  notify_user "Lỗi: không cài được OpenClaw. Xem Nhật ký cài đặt."
fi

# ── 3. Gateway install ─────────────────────────────────────────────────────────
log_line "[3/5] openclaw gateway install --force"
notify_user "Bước 3/5: Cấu hình dịch vụ OpenClaw Gateway…"

if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  if sudo -u "$CONSOLE_USER" -H bash -c "export PATH=\"/usr/local/bin:/opt/homebrew/bin:\$PATH\"; openclaw gateway install --force"; then
    log_line "  ✓ gateway install xong."
  else
    log_line "  ! gateway install báo lỗi (xem chi tiết phía trên)."
  fi
else
  if openclaw gateway install --force; then
    log_line "  ✓ gateway install xong."
  else
    log_line "  ! gateway install báo lỗi."
  fi
fi

# ── 4. Gateway start ───────────────────────────────────────────────────────────
log_line "[4/5] openclaw gateway start"
notify_user "Bước 4/5: Khởi động OpenClaw Gateway…"

if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  sudo -u "$CONSOLE_USER" -H bash -c "export PATH=\"/usr/local/bin:/opt/homebrew/bin:\$PATH\"; openclaw gateway start" || true
else
  openclaw gateway start || true
fi
log_line "  ✓ Đã gọi gateway start."

# ── 5. Ollama ──────────────────────────────────────────────────────────────────
log_line "[5/5] Cài Ollama (curl install.sh — có thể vài phút)…"
notify_user "Bước 5/5: Đang tải và cài Ollama…"

if curl -fL https://ollama.com/install.sh | sh; then
  log_line "  ✓ Ollama đã cài."
else
  log_line "  ! Cảnh báo: cài Ollama thất bại — tải thủ công tại https://ollama.com"
  notify_user "Cảnh báo: cài Ollama thất bại. Có thể cài thủ công sau."
fi

log_line "=== Hoàn tất postinstall $(date) === Nhật ký đầy đủ: $LOG"
notify_user "VClaw: cài đặt xong. Mở VClaw từ Applications."

if [[ -d "/Applications/VClaw.app" && -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  sudo -u "$CONSOLE_USER" -H open -a VClaw 2>/dev/null || true
fi

exit 0
