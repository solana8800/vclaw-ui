    "providers": {
      "ollama": {
        "api": "ollama",
        "apiKey": "OLLAMA_API_KEY",
        "baseUrl": "${OLLAMA_BASE_URL}",
        "models": [
          {
            "id": "${OLLAMA_CLOUD_KIMI}",
            "name": "Kimi (Cloud)",
            "contextWindow": 128000,
