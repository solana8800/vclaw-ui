#!/bin/bash
# VClaw pkg postinstall — Dứt điểm lỗi cài đặt OpenClaw
# Script này chạy dưới quyền root.
set +e

LOG="/tmp/vclaw-postinstall.log"
echo "=== VClaw Postinstall Start $(date) ===" > "$LOG"

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# Resolve the real logged-in user
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && CONSOLE_USER="$(logname 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
fi

echo "------------------------------------------------------------"
echo "🦞 ĐANG CÀI ĐẶT HỆ THỐNG VCLAW CỐT LÕI (BẢN SỬA LỖI)"
echo "------------------------------------------------------------"

# ── 1. Cấu hình ban đầu ───────────────────────────────────────────────────────
CONFIG_DIR="$USER_HOME/.openclaw"
CONFIG_FILE="$CONFIG_DIR/openclaw.json"
DEFAULT_CFG="/Applications/VClaw.app/Contents/Resources/openclaw.default.json"

echo -e "\n[1/3] 📂 Chuẩn bị thư mục cấu hình..."
mkdir -p "$CONFIG_DIR"
if [[ -f "$DEFAULT_CFG" && ! -f "$CONFIG_FILE" ]]; then
  cp "$DEFAULT_CFG" "$CONFIG_FILE"
fi
# Luôn chown lại cho user để họ có quyền sửa config
[[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true

# ── 2. Cài đặt OpenClaw (Sử dụng trực tiếp quyền Root của bộ cài) ─────────────
echo -e "\n[2/3] 🦀 Cài đặt OpenClaw Core (Vui lòng đợi)..."
# Chạy trực tiếp bằng root để ghi vào hệ thống node_modules/global
# Dùng lệnh npm install -g trực tiếp thay vì script trung gian để kiểm soát lỗi tốt hơn
if npm install -g openclaw@latest; then
  echo "  ✓ OpenClaw đã được cài đặt vào hệ thống (Toàn cục)."
  
  # Khởi chạy gateway bằng quyền của người dùng (để Gateway tạo log/db đúng chỗ)
  if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
    sudo -u "$CONSOLE_USER" -H bash -c "export PATH=\"/usr/local/bin:/opt/homebrew/bin:\$PATH\"; openclaw gateway install --force && openclaw gateway start"
  else
    openclaw gateway install --force
    openclaw gateway start
  fi
  echo "  ✓ Dịch vụ OpenClaw Gateway đã kích hoạt."
else
  echo "  ! Lỗi: Không thể cài đặt OpenClaw qua npm. Vui lòng kiểm tra kết nối mạng."
fi

# ── 3. Cài đặt Ollama Engine ──────────────────────────────────────────────────
echo -e "\n[3/3] 🧠 Cài đặt Ollama Engine..."
if curl -fL https://ollama.com/install.sh | sh; then
  echo "  ✓ Ollama Engine đã sẵn sàng."
else
  echo "  ! Cảnh báo: Tải Ollama thất bại."
fi

# ── 4. Hoàn tất ───────────────────────────────────────────────────────────────
echo -e "\n------------------------------------------------------------"
echo "✅ HOÀN TẤT. Hệ thống đã sẵn sàng!"
echo "------------------------------------------------------------"

if [[ -d "/Applications/VClaw.app" ]]; then
  sudo -u "$CONSOLE_USER" -H open -a VClaw 2>/dev/null || true
fi

exit 0
