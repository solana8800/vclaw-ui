#!/bin/bash
# VClaw pkg postinstall — Cài đặt "Chuẩn 100%" theo OpenClaw/Ollama
# Script này chạy dưới quyền root.
set +e

LOG="/tmp/vclaw-postinstall.log"
echo "=== VClaw Postinstall Start $(date) ===" > "$LOG"

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# Resolve the real logged-in user
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && CONSOLE_USER="$(logname 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
fi

echo "------------------------------------------------------------"
echo "🦞 ĐANG CÀI ĐẶT THEO TIÊU CHUẨN HỆ THỐNG"
echo "------------------------------------------------------------"

# ── 1. Cấu hình ban đầu ───────────────────────────────────────────────────────
CONFIG_DIR="$USER_HOME/.openclaw"
CONFIG_FILE="$CONFIG_DIR/openclaw.json"
DEFAULT_CFG="/Applications/VClaw.app/Contents/Resources/openclaw.default.json"

echo -e "\n[1/3] 📂 Khởi tạo thư mục cấu hình..."
mkdir -p "$CONFIG_DIR"
if [[ -f "$DEFAULT_CFG" && ! -f "$CONFIG_FILE" ]]; then
  cp "$DEFAULT_CFG" "$CONFIG_FILE"
fi
[[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true

# ── 2. Cài đặt OpenClaw (Chuẩn: ~/.local/bin) ─────────────────────────────────
echo -e "\n[2/3] 🦀 Cài đặt OpenClaw Core (Theo chuẩn openclaw.ai)..."
# Chạy dưới danh nghĩa người dùng và mang theo biến $HOME của họ
sudo -u "$CONSOLE_USER" -H bash -c "curl -fL https://openclaw.ai/install.sh | bash"

# Khởi chạy service của người dùng
sudo -u "$CONSOLE_USER" -H bash -c "export PATH=\"\$HOME/.local/bin:\$PATH\"; openclaw gateway install --force && openclaw gateway start"
echo "  ✓ OpenClaw đã được cài đặt vào thư mục cá nhân."

# ── 3. Cài đặt Ollama (Chuẩn: /usr/local/bin) ──────────────────────────────────
echo -e "\n[3/3] 🧠 Cài đặt Ollama Engine (Theo chuẩn ollama.com)..."
# Ollama cài hệ thống nên dùng quyền root hiện tại
curl -fL https://ollama.com/install.sh | sh
echo "  ✓ Ollama đã được cài đặt vào hệ thống."

# ── 4. Hoàn tất ───────────────────────────────────────────────────────────────
echo -e "\n------------------------------------------------------------"
echo "✅ HOÀN TẤT. Mọi ứng dụng đã nằm đúng vị trí tiêu chuẩn!"
echo "------------------------------------------------------------"

if [[ -d "/Applications/VClaw.app" ]]; then
  sudo -u "$CONSOLE_USER" -H open -a VClaw 2>/dev/null || true
fi

exit 0
