#!/usr/bin/env bash
# VClaw pkg postinstall — runs after VClaw.app is copied to /Applications
# Fast: only seeds config then launches background setup (OpenClaw + Ollama).
# NOTE: pkg scripts run as root. CONSOLE_USER is the actual logged-in user.
set -uo pipefail

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# ── Resolve the real logged-in user ───────────────────────────────────────────
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && \
  CONSOLE_USER="$(logname 2>/dev/null || true)"
[[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" ]] && \
  CONSOLE_USER="$(id -un 2>/dev/null || true)"

if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  USER_HOME="$(eval echo ~"$CONSOLE_USER")"
else
  USER_HOME="$HOME"
  CONSOLE_USER=""
fi

CONFIG_DIR="$USER_HOME/.openclaw"
CONFIG_FILE="$CONFIG_DIR/openclaw.json"
DEFAULT_CFG="/Applications/VClaw.app/Contents/Resources/openclaw.default.json"

echo "· Postinstall cho user: ${CONSOLE_USER:-root}"

# ── 1. Seed config (nhanh, không cần mạng) ────────────────────────────────────
if [[ ! -f "$CONFIG_FILE" ]]; then
  mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<'JSON'
{
  "env": {
    "vars": {
      "OLLAMA_CLOUD_DEEPSEEK": "deepseek-v3.1:671b-cloud",
      "OLLAMA_CLOUD_KIMI": "kimi-k2.5:cloud",
      "OLLAMA_CLOUD_QWEN": "qwen3.5:397b-cloud",
      "OLLAMA_BASE_URL": "http://127.0.0.1:11434",
      "OPENROUTER_API_KEY": "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",
      "OPENROUTER_FREE_GEMMA": "google/gemma-4-31b-it:free",
      "OPENROUTER_FREE_NVIDIA": "nvidia/nemotron-3-120b-super:free",
      "OPENROUTER_AUTO": "openrouter/auto"
    }
  },
  "agents": {
    "defaults": {
      "heartbeat": { "every": "1m" },
      "model": {
        "primary": "ollama/${OLLAMA_CLOUD_DEEPSEEK}",
        "fallback": [
          "ollama/${OLLAMA_CLOUD_KIMI}",
          "ollama/${OLLAMA_CLOUD_QWEN}",
          "openrouter/${OPENROUTER_AUTO}",
          "openrouter/${OPENROUTER_FREE_GEMMA}",
          "openrouter/${OPENROUTER_FREE_NVIDIA}"
        ]
      },
      "workspace": "~/Documents",
      "models": {
        "ollama/${OLLAMA_CLOUD_KIMI}": { "alias": "Kimi" },
        "ollama/${OLLAMA_CLOUD_DEEPSEEK}": { "alias": "DeepSeek" },
        "ollama/${OLLAMA_CLOUD_QWEN}": { "alias": "Qwen" },
        "openrouter/${OPENROUTER_FREE_GEMMA}": { "alias": "Gemma Free" },
        "openrouter/${OPENROUTER_FREE_NVIDIA}": { "alias": "Nvidia Free" },
        "openrouter/${OPENROUTER_AUTO}": { "alias": "Auto Router" }
      }
    }
  },
  "gateway": {
    "bind": "loopback",
    "mode": "local",
    "port": 18789,
    "auth": { "mode": "none" }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "api": "ollama",
        "apiKey": "OLLAMA_API_KEY",
        "baseUrl": "${OLLAMA_BASE_URL}",
        "models": [
          { "id": "${OLLAMA_CLOUD_KIMI}", "name": "Kimi (Cloud)", "contextWindow": 128000, "maxTokens": 8192 },
          { "id": "${OLLAMA_CLOUD_DEEPSEEK}", "name": "DeepSeek V3 (Cloud)", "contextWindow": 128000, "maxTokens": 8192 },
          { "id": "${OLLAMA_CLOUD_QWEN}", "name": "Qwen Max (Cloud)", "contextWindow": 128000, "maxTokens": 8192 }
        ]
      },
      "openrouter": {
        "api": "openai",
        "apiKey": "${OPENROUTER_API_KEY}",
        "baseUrl": "https://openrouter.ai/api/v1",
        "models": [
          { "id": "${OPENROUTER_FREE_GEMMA}", "name": "Gemma Free", "contextWindow": 1000000, "maxTokens": 8192 },
          { "id": "${OPENROUTER_FREE_NVIDIA}", "name": "Nvidia Free", "contextWindow": 262144, "maxTokens": 8192 },
          { "id": "${OPENROUTER_AUTO}", "name": "Auto Router", "contextWindow": 128000, "maxTokens": 8192 }
        ]
      }
    }
  },
  "plugins": {
    "allow": ["openclaw-web-search", "ollama", "memory-core", "browser", "openrouter"],
    "entries": {
      "ollama": { "enabled": true },
      "openclaw-web-search": { "enabled": true },
      "browser": { "enabled": true },
      "openrouter": { "enabled": true }
    }
  },
  "wizard": {
    "lastRunAt": "2026-01-01T00:00:00.000Z",
    "lastRunCommand": "onboard",
    "lastRunMode": "local"
  }
}
JSON
  [[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true
  echo "✓ Config seeded → $CONFIG_FILE"
else
  echo "· Config đã có — giữ nguyên"
fi

# ── 2. Tạo background setup script ────────────────────────────────────────────
SETUP_SCRIPT="/tmp/vclaw-setup-$$.sh"

cat > "$SETUP_SCRIPT" <<'SCRIPT'
#!/usr/bin/env bash
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
LOG="$HOME/Library/Logs/vclaw-setup.log"
mkdir -p "$(dirname "$LOG")"
exec >> "$LOG" 2>&1

echo ""
echo "=== VClaw background setup $(date) ==="

echo "[1/3] Cài OpenClaw..."
if curl -fsSL https://openclaw.ai/install.sh | bash; then
  echo "✓ OpenClaw OK"
  export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
  openclaw gateway install --force 2>/dev/null || true
  openclaw gateway start           2>/dev/null || true
  echo "✓ Gateway đã khởi động"
else
  echo "✗ OpenClaw thất bại"
fi

echo "[2/3] Cài Ollama (~500MB)..."
if curl -fsSL https://ollama.com/install.sh | sh; then
  echo "✓ Ollama OK"
else
  echo "✗ Ollama thất bại — tải tại https://ollama.com"
fi

echo "=== Setup hoàn thành $(date) ==="
rm -f "$0"
SCRIPT

chmod +x "$SETUP_SCRIPT"

# ── 3. Chạy setup script ngầm với user thực ───────────────────────────────────
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  sudo -u "$CONSOLE_USER" bash "$SETUP_SCRIPT" &
else
  bash "$SETUP_SCRIPT" &
fi
disown $! 2>/dev/null || true
echo "✓ Background setup đã khởi động"
echo "  Log: ~/Library/Logs/vclaw-setup.log"

# ── 4. Mở VClaw (gateway có thể chưa sẵn sàng, app xử lý gracefully) ─────────
sleep 1
if [[ -d "/Applications/VClaw.app" ]]; then
  if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
    sudo -u "$CONSOLE_USER" open -a VClaw 2>/dev/null || true
  else
    open -a VClaw 2>/dev/null || true
  fi
fi
