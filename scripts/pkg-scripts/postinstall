        },
        "ollama/${OLLAMA_CLOUD_QWEN}": {
          "alias": "Qwen"
        },
        "openrouter/${OPENROUTER_FREE_GEMMA}": {
          "alias": "Gemma Free"
        },
        "openrouter/${OPENROUTER_FREE_NVIDIA}": {
          "alias": "Nvidia Free"
        },
        "openrouter/${OPENROUTER_AUTO}": {
          "alias": "Auto Router"
        }
      }
    }
  },
  "gateway": {
    "bind": "loopback",
    "mode": "local",
    "port": 18789,
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_AUTH_TOKEN}"
    }
  },
  "models": {
