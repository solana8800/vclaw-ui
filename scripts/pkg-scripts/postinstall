JSON
  [[ -n "$CONSOLE_USER" ]] && chown -R "$CONSOLE_USER" "$CONFIG_DIR" 2>/dev/null || true
  echo "✓ Config seeded → $CONFIG_FILE"
else
  echo "· Config đã có — giữ nguyên"
fi

# ── 2. Tạo background setup script ────────────────────────────────────────────
SETUP_SCRIPT="/tmp/vclaw-setup-$$.sh"

cat > "$SETUP_SCRIPT" <<'SCRIPT'
#!/usr/bin/env bash
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
LOG="$HOME/Library/Logs/vclaw-setup.log"
mkdir -p "$(dirname "$LOG")"
exec >> "$LOG" 2>&1

echo ""
echo "=== VClaw background setup $(date) ==="

echo "[1/3] Cài OpenClaw..."
if curl -fsSL https://openclaw.ai/install.sh | bash; then
  echo "✓ OpenClaw OK"
  export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
  openclaw gateway install --force 2>/dev/null || true
  openclaw gateway start           2>/dev/null || true
  echo "✓ Gateway đã khởi động"
else
  echo "✗ OpenClaw thất bại"
fi

echo "[2/3] Cài Ollama (~500MB)..."
if curl -fsSL https://ollama.com/install.sh | sh; then
  echo "✓ Ollama OK"
else
  echo "✗ Ollama thất bại — tải tại https://ollama.com"
fi

echo "=== Setup hoàn thành $(date) ==="
rm -f "$0"
SCRIPT

chmod +x "$SETUP_SCRIPT"

# ── 3. Chạy setup script ngầm với user thực ───────────────────────────────────
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
  sudo -u "$CONSOLE_USER" bash "$SETUP_SCRIPT" &
else
  bash "$SETUP_SCRIPT" &
fi
disown $! 2>/dev/null || true
echo "✓ Background setup đã khởi động"
echo "  Log: ~/Library/Logs/vclaw-setup.log"

# ── 4. Mở VClaw (gateway có thể chưa sẵn sàng, app xử lý gracefully) ─────────
sleep 1
if [[ -d "/Applications/VClaw.app" ]]; then
  if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
    sudo -u "$CONSOLE_USER" open -a VClaw 2>/dev/null || true
  else
    open -a VClaw 2>/dev/null || true
  fi
fi
