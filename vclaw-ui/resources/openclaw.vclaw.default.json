{
  "meta": {
    "lastTouchedVersion": "2026.3.28",
    "lastTouchedAt": "2026-05-06T05:18:48.302Z"
  },
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "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",
      "OPENROUTER_AUTO": "openrouter/auto",
      "TELEGRAM_BOT_TOKEN": "8693815388:AAE6tgA4UYPEoZip1_CqcvIQCmjDOZMzilc"
    }
  },
  "browser": {
    "attachOnly": true,
    "defaultProfile": "openclaw",
    "profiles": {
      "openclaw": {
        "cdpUrl": "http://127.0.0.1:9222",
        "color": "#4285F4"
      }
    }
  },
  "ui": {
    "assistant": {
      "name": "VClaw",
      "avatar": "🦞"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek-web": {
        "baseUrl": "https://chat.deepseek.com",
        "api": "deepseek-web",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "contextWindow": 64000,
            "maxTokens": 4096
          }
        ]
      },
      "gemini-web": {
        "baseUrl": "https://gemini.google.com",
        "api": "gemini-web",
        "models": [
          {
            "id": "gemini-3-flash",
            "name": "Gemini 3 Flash",
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "OPENROUTER_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "auto",
            "name": "OpenRouter Auto",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek-web/deepseek-chat",
        "fallbacks": [
          "gemini-web/gemini-3-flash",
          "openrouter/auto"
        ]
      },
      "models": {
        "deepseek-web/deepseek-chat": {
          "alias": "DeepSeek V3"
        },
        "gemini-web/gemini-3-flash": {
          "alias": "Gemini 3 Flash"
        },
        "openrouter/auto": {
          "alias": "OpenRouter Auto"
        }
      },
      "workspace": "~/.openclaw/workspace",
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "15m"
      }
    }
  },
  "tools": {
    "profile": "full",
    "web": {
      "search": {
        "enabled": true
      },
      "fetch": {
        "enabled": true
      }
    },
    "sessions": {
      "visibility": "all"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "bash": false,
    "config": false,
    "mcp": false,
    "plugins": false,
    "debug": false,
    "restart": true,
    "ownerDisplay": "raw",
    "allowFrom": {
      "zalouser": [],
      "zalo": []
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "resetByType": {
      "direct": {
        "mode": "idle",
        "idleMinutes": 240
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": true
        },
        "bootstrap-extra-files": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [
        "1575333400"
      ],
      "groupPolicy": "allowlist",
      "streaming": "partial"
    },
    "zalouser": {
      "enabled": true,
      "dangerouslyAllowNameMatching": false,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "*": {
          "allow": true,
          "requireMention": true
        }
      }
    }
  },
  "gateway": {
    "port": 3001,
    "mode": "local",
    "bind": "custom",
    "customBindHost": "127.0.0.1",
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "62b791625fa441be036acd3c206b7e14e2bb13c803355823"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "vclaw-business": {
        "command": "node",
        "args": [
          "__VCLAW_AGENT_TOOLS_MCP_STDIO__"
        ],
        "env": {
          "VCLAW_AGENT_TOOLS_URL": "http://127.0.0.1:12687/api/vclaw/agent-tools",
          "VCLAW_AGENT_TOOLS_SECRET": "67859bd51900be1751e4b6db3da02f2c2ca81fc3175742e2e0c341e9b56c4570"
        },
        "description": "VClaw Business Tools — stdio MCP bridge vào database/product/order/payment của VClaw UI"
      }
    }
  },
  "plugins": {
    "allow": [
      "browser",
      "telegram",
      "zalouser"
    ],
    "entries": {
      "browser": {
        "enabled": true,
        "config": {}
      },
      "telegram": {
        "enabled": true,
        "config": {}
      },
      "zalouser": {
        "enabled": true,
        "config": {}
      }
    }
  }
}
