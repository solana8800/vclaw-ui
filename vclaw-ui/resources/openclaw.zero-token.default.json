{
  "browser": {
    "attachOnly": true,
    "defaultProfile": "openclaw",
    "profiles": {
      "openclaw": {
        "cdpUrl": "http://127.0.0.1:9222",
        "color": "#4285F4"
      }
    }
  },
  "gateway": {
    "bind": "loopback",
    "mode": "local",
    "port": 3001,
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "62b791625fa441be036acd3c206b7e14e2bb13c803355823"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "heartbeat": {
        "every": "15m"
      },
      "model": {
        "primary": "deepseek-web/deepseek-chat",
        "fallbacks": [
          "deepseek-web/deepseek-reasoner"
        ]
      },
      "models": {
        "deepseek-web/deepseek-chat": {
          "alias": "DeepSeek Chat"
        },
        "deepseek-web/deepseek-reasoner": {
          "alias": "DeepSeek Reasoner"
        }
      },
      "workspace": "~/.openclaw/workspace",
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek-web": {
        "api": "deepseek-web",
        "baseUrl": "https://chat.deepseek.com",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "contextWindow": 64000,
            "maxTokens": 4096
          }
        ]
      },
      "chatgpt-web": {
        "api": "chatgpt-web",
        "baseUrl": "https://chatgpt.com",
        "models": [
          {
            "id": "gpt-4o",
            "name": "ChatGPT Web",
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      },
      "claude-web": {
        "api": "claude-web",
        "baseUrl": "https://claude.ai",
        "models": [
          {
            "id": "claude-sonnet-4",
            "name": "Claude Web",
            "contextWindow": 200000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "plugins": {
    "allow": [
      "browser",
      "zalouser"
    ],
    "entries": {
      "browser": {
        "enabled": true
      },
      "zalouser": {
        "enabled": true
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "zalouser": {
      "enabled": true,
      "dangerouslyAllowNameMatching": false,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "*": {
          "allow": true,
          "requireMention": true
        }
      }
    }
  },
  "commands": {
    "bash": false,
    "config": false,
    "mcp": false,
    "plugins": false,
    "debug": false,
    "allowFrom": {
      "zalouser": [],
      "zalo": []
    }
  },
  "tools": {
    "profile": "full",
    "sessions": {
      "visibility": "all"
    },
    "web": {
      "fetch": {
        "enabled": true
      },
      "search": {
        "enabled": true
      }
    }
  },
  "mcp": {
    "servers": {
      "vclaw-business": {
        "url": "http://127.0.0.1:12687/api/vclaw/agent-tools",
        "auth": {
          "type": "bearer",
          "token": "67859bd51900be1751e4b6db3da02f2c2ca81fc3175742e2e0c341e9b56c4570"
        },
        "description": "VClaw Business Tools — tạo đơn hàng, quản lý khách hàng, tạo QR thanh toán"
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": true
        },
        "bootstrap-extra-files": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "ui": {
    "assistant": {
      "name": "VClaw",
      "avatar": "🦞"
    }
  }
}
