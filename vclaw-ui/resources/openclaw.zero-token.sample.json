{
  "browser": {
    "attachOnly": true,
    "defaultProfile": "openclaw",
    "profiles": {
      "openclaw": {
        "cdpUrl": "http://127.0.0.1:9222",
        "color": "#4285F4"
      }
    }
  },
  "gateway": {
    "port": 3001,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_STRONG_RANDOM_GATEWAY_TOKEN"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek-web/deepseek-chat",
        "fallbacks": [
          "deepseek-web/deepseek-reasoner"
        ]
      },
      "models": {
        "deepseek-web/deepseek-chat": {
          "alias": "DeepSeek Chat"
        },
        "deepseek-web/deepseek-reasoner": {
          "alias": "DeepSeek Reasoner"
        }
      },
      "workspace": "~/.openclaw-zero/workspace"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek-web": {
        "api": "deepseek-web",
        "baseUrl": "https://chat.deepseek.com",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "contextWindow": 64000,
            "maxTokens": 4096
          }
        ]
      },
      "chatgpt-web": {
        "api": "chatgpt-web",
        "baseUrl": "https://chatgpt.com",
        "models": [
          {
            "id": "gpt-4o",
            "name": "ChatGPT Web",
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      },
      "claude-web": {
        "api": "claude-web",
        "baseUrl": "https://claude.ai",
        "models": [
          {
            "id": "claude-sonnet-4",
            "name": "Claude Web",
            "contextWindow": 200000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "plugins": {
    "allow": [
      "browser",
      "zalouser"
    ],
    "entries": {
      "browser": {
        "enabled": true
      },
      "zalouser": {
        "enabled": true
      }
    },
    "installs": {
      "zalouser": {
        "source": "archive",
        "spec": "clawhub:@openclaw/zalouser@2026.3.22",
        "installPath": "~/.openclaw/extensions/zalouser",
        "version": "2026.3.22",
        "integrity": "sha256-+0qHOLjr/S+MMpS37MOEVFgTcvHHtwpzjYjvnVCxLfo=",
        "resolvedAt": "2026-04-23T10:25:27.257Z",
        "clawhubUrl": "https://clawhub.ai",
        "clawhubPackage": "@openclaw/zalouser",
        "clawhubFamily": "code-plugin",
        "clawhubChannel": "official",
        "sourcePath": "~/.openclaw/bundled-plugins/zalouser-bundled.tgz"
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "zalouser": {
      "enabled": true,
      "dangerouslyAllowNameMatching": false,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "*": {
          "allow": true,
          "requireMention": true
        }
      }
    }
  },
  "commands": {
    "allowFrom": {
      "zalouser": [],
      "zalo": []
    }
  }
}
