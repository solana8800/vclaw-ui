generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./business.sqlite"
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  phone           String?
  email           String?
  shippingAddress String?
  channel         String
  labels          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  gender          String?
  preferredName   String?
  bookings        Booking[]
  conversations   Conversation[]
  orders          Order[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  amount            Float
  status            String      @default("PENDING")
  fulfillmentType   String      @default("PHYSICAL")
  fulfillmentStatus String      @default("PENDING")
  shippingAddress   String?
  trackingNumber    String?
  shippingEstimate  Float?
  shippingNote      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  payments          Payment[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  amount        Float
  status        String
  evidenceImage String?
  method        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String    @id @default(cuid())
  customerId  String
  serviceName String
  startTime   DateTime
  endTime     DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  type      String
  title     String
  subtitle  String?
  amount    String?
  isUrgent  Boolean  @default(false)
  status    String
  timeAgo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  price              Float
  description        String?
  imageUrl           String?
  category           String?
  status             String      @default("ACTIVE")
  type               String      @default("GOODS")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  metadata           String?
  productCode        String?     @unique
  images             String?
  /// JSON lưu ProductCommercePolicy — ưu tiên hơn metadata.commercePolicy. Default: PREPAID khi không set.
  commercePolicyJson String?
  orderItems         OrderItem[]
}

model ShopSettings {
  id                     String   @id @default("default")
  shopName               String?
  preferredChannel       String?
  bankName               String?
  accountHolder          String?
  accountNumber          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  address                String?
  /// JSON cấu hình quy tắc tự động hóa: { paymentFollowup, appointmentReminder, leadReactivation }
  automationRulesJson    String?
  email                  String?
  phone                  String?
  shopLogoUrl            String?
  website                String?
  /// JSON cấu hình cổng duyệt: { paymentAutoApprove, automationEnabled }
  approvalConfigJson     String?
  language               String?  @default("vi")
  /// JSON cấu hình thông báo: { reminderInterval, followUpCadence }
  notificationConfigJson String?
  shipperGroupId         String?
  ghnToken               String?
  ghnShopId              String?
  /// ID quận/huyện nguồn gửi hàng trên GHN (mặc định 1442 = Bình Thạnh, HCM nếu để trống)
  ghnFromDistrictId      Int?
  shopCode               String?
}

model IntegrationAccount {
  id          String    @id @default(cuid())
  provider    String    @unique
  accountId   String?
  displayName String?
  avatarUrl   String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IntegrationGroup {
  id          String   @id @default(cuid())
  provider    String
  accountId   String?
  groupId     String   @unique
  name        String
  memberCount Int?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Danh bạ peer (bạn bè / DM) cache từ `directory.peers.list` — zalouser.
model IntegrationPeer {
  id        String   @id @default(cuid())
  provider  String
  accountId String?
  /// Mã gửi tin chuẩn kênh, ví dụ `user:3449465574915916286`
  peerId    String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, peerId])
}

/// OAuth / token kênh pilot (local-first; mã hóa field khi triển khai hosted).
model ChannelConnection {
  id                String    @id @default(cuid())
  provider          String    @unique
  appId             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  externalAccountId String?
  profileJson       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Luồng hội thoại đồng bộ từ webhook (Zalo OA pilot).
model Conversation {
  id                 String                @id @default(cuid())
  provider           String
  externalThreadId   String
  customerId         String?
  title              String?
  openclawSessionKey String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  status             String?
  customer           Customer?             @relation(fields: [customerId], references: [id])
  messages           ConversationMessage[]

  @@index([provider, externalThreadId])
  @@index([customerId])
}

model ConversationMessage {
  id                String       @id @default(cuid())
  conversationId    String
  direction         String
  body              String
  externalMessageId String?
  rawPayloadJson    String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Nhật ký gọi tool nội bộ (OpenClaw / gateway HTTP → VClaw).
model AgentToolLog {
  id        String   @id @default(cuid())
  tool      String
  payload   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())
}

model AutomationJob {
  id             String   @id @default(cuid())
  type           String   @default("OUTBOUND")
  title          String
  status         String   @default("QUEUED")
  target         String?
  result         String?
  channel        String?
  notes          String?
  draftContent   String?
  /// NONE | PENDING_APPROVAL | APPROVED | REJECTED
  approvalStatus String   @default("NONE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
