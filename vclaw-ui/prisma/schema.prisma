generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./business.sqlite"
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  phone           String?
  email           String?
  shippingAddress String?
  channel         String
  labels          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  gender          String?
  preferredName   String?
  bookings        Booking[]
  conversations   Conversation[]
  orders          Order[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  amount            Float
  status            String      @default("PENDING")
  fulfillmentType   String      @default("PHYSICAL")
  fulfillmentStatus String      @default("PENDING")
  shippingAddress   String?
  trackingNumber    String?
  shippingEstimate  Float?
  shippingNote      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  payments          Payment[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  amount        Float
  status        String
  evidenceImage String?
  method        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String    @id @default(cuid())
  customerId  String
  serviceName String
  startTime   DateTime
  endTime     DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  type      String
  title     String
  subtitle  String?
  amount    String?
  isUrgent  Boolean  @default(false)
  status    String
  timeAgo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  price              Float
  description        String?
  imageUrl           String?
  category           String?
  status             String      @default("ACTIVE")
  type               String      @default("GOODS")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  metadata           String?
  productCode        String?     @unique
  images             String?
  /// JSON lưu ProductCommercePolicy — ưu tiên hơn metadata.commercePolicy. Default: PREPAID khi không set.
  commercePolicyJson String?
  orderItems         OrderItem[]
}

model ShopSettings {
  id                     String   @id @default("default")
  shopName               String?
  preferredChannel       String?
  bankName               String?
  accountHolder          String?
  accountNumber          String?
  bankThreadId           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  address                String?
  /// JSON cấu hình quy tắc tự động hóa: { paymentFollowup, appointmentReminder, leadReactivation }
  automationRulesJson    String?
  email                  String?
  phone                  String?
  shopLogoUrl            String?
  website                String?
  /// JSON cấu hình cổng duyệt: { paymentAutoApprove, automationEnabled }
  approvalConfigJson     String?
  language               String?  @default("vi")
  /// JSON cấu hình thông báo: { reminderInterval, followUpCadence }
  notificationConfigJson String?
  shipperGroupId         String?
  ghnToken               String?
  ghnShopId              String?
  /// ID quận/huyện nguồn gửi hàng trên GHN (mặc định 1442 = Bình Thạnh, HCM nếu để trống)
  ghnFromDistrictId      Int?
  shopCode               String?
  firecrawlToken         String?
}

/// Cấu hình Head Hunter / tuyển dụng — tách khỏi ShopSettings (retail).
model RecruitmentSettings {
  id                    String   @id @default("default")
  linxaToken            String?
  firecrawlToken        String?
  linkedinCompanyUrl    String?
  autoInviteOnMatch     Boolean  @default(false)
  autoIntroOnAccept     Boolean  @default(false)
  autoCollectOnPositive Boolean  @default(false)
  autoRemindInterview   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model IntegrationAccount {
  id          String    @id @default(cuid())
  provider    String    @unique
  accountId   String?
  displayName String?
  avatarUrl   String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IntegrationGroup {
  id          String   @id @default(cuid())
  provider    String
  accountId   String?
  groupId     String   @unique
  name        String
  memberCount Int?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Danh bạ peer (bạn bè / DM) cache từ `directory.peers.list` — zalouser.
model IntegrationPeer {
  id        String   @id @default(cuid())
  provider  String
  accountId String?
  /// Mã gửi tin chuẩn kênh, ví dụ `user:3449465574915916286`
  peerId    String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, peerId])
}

/// OAuth / token kênh pilot (local-first; mã hóa field khi triển khai hosted).
model ChannelConnection {
  id                String    @id @default(cuid())
  provider          String    @unique
  appId             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  externalAccountId String?
  profileJson       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Luồng hội thoại đồng bộ từ webhook (Zalo OA pilot).
model Conversation {
  id                 String                @id @default(cuid())
  provider           String
  externalThreadId   String
  customerId         String?
  candidateId        String?
  title              String?
  openclawSessionKey String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  status             String?
  customer           Customer?             @relation(fields: [customerId], references: [id])
  candidate          Candidate?            @relation(fields: [candidateId], references: [id])
  messages           ConversationMessage[]

  @@index([provider, externalThreadId])
  @@index([customerId])
  @@index([candidateId])
}

model ConversationMessage {
  id                String       @id @default(cuid())
  conversationId    String
  direction         String
  body              String
  externalMessageId String?
  rawPayloadJson    String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Nhật ký gọi tool nội bộ (OpenClaw / gateway HTTP → VClaw).
model AgentToolLog {
  id        String   @id @default(cuid())
  tool      String
  payload   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())
}

model AutomationJob {
  id             String   @id @default(cuid())
  type           String   @default("OUTBOUND")
  title          String
  status         String   @default("QUEUED")
  target         String?
  result         String?
  channel        String?
  notes          String?
  draftContent   String?
  /// NONE | PENDING_APPROVAL | APPROVED | REJECTED
  approvalStatus String   @default("NONE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Tin nhắn từ kênh/OA Zalo (Techcombank, ngân hàng…).
/// Không xử lý qua AI; dùng để tra cứu biến động số dư.
model ChannelNotification {
  id          String   @id @default(cuid())
  channel     String
  threadId    String
  senderName  String   @default("")
  rawMessage  String
  msgId       String?
  msgType     String?
  /// Số dư sau giao dịch (VND), nếu parse được
  balance     Float?
  /// Số tiền giao dịch (dương = cộng, âm = trừ)
  amount      Float?
  /// Nội dung giao dịch (ND/description)
  description String?
  /// Mã đơn hàng trích xuất từ nội dung chuyển khoản (nếu có)
  orderNumber String?
  createdAt   DateTime @default(now())

  @@index([channel, threadId])
  @@index([createdAt])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  industry    String?  @default("RETAIL")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobPosition {
  id                 String      @id @default(cuid())
  title              String
  description        String? // Mô tả JD nội bộ — không ghi đè bởi bài đăng LinkedIn
  linkedinPostCopy   String? // Nội dung marketing đã soạn cho bài đăng feed
  requirements       String?
  hiringPolicy       String? // Chính sách tuyển dụng
  interviewProcess   String? // Quy trình phỏng vấn
  salaryRange        String? // Mức lương
  benefits           String? // Chế độ đãi ngộ
  companyInfo        String? // Thông tin công ty
  publicInstructions String? // Thông tin public cho AI trả lời
  projectTeamInfo    String? // Thông tin dự án / team
  headcount          Int? // Số lượng cần tuyển
  hiringTimeline     String? // Thời gian tuyển
  urgencyLevel       String      @default("NORMAL") // URGENT, NORMAL
  contractType       String? // FULL_TIME, PART_TIME, CONTRACT, INTERN
  workMode           String? // REMOTE, HYBRID, ONSITE
  status             String      @default("OPEN")
  workspaceId        String?
  linkedinJobId      String? // ID bài đăng từ Fuku AI
  linkedinJobUrl     String? // URL bài đăng mới nhất trên LinkedIn
  linkedinPostedAt   DateTime? // Lần đăng LinkedIn gần nhất
  companyUrl         String? // URL Company Page LinkedIn
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  candidates         Candidate[]
  linkedinPosts      JobLinkedInPost[]
}

model JobLinkedInPost {
  id            String      @id @default(cuid())
  jobPositionId String
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  postUrl       String? // URL bài trên feed / page
  title         String? // Tiêu đề vị trí (metadata ngắn)
  target        String? // personal | company
  companyUrl    String? // Link Company Page khi đăng lên page
  hasImage      Boolean     @default(false)
  postedAt      DateTime    @default(now())

  @@index([jobPositionId, postedAt])
}

model Candidate {
  id                  String       @id @default(cuid())
  name                String
  headline            String?
  profileUrl          String?      @unique  // Slug URL: /in/que-le-ta/
  linkedinProfileIdUrl String?     @unique  // ID URL: /in/ACoAACPvLaUB.../
  email               String?
  phone               String?
  status              String       @default("POTENTIAL")
  cvText              String?
  cvFileUrl           String?
  extractedInfo       String? // Trích xuất từ LinkedIn
  chatInfo            String? // Thông tin thu thập từ chat
  conversationHistory String? // Lịch sử hội thoại (JSON string)
  strengths           String? // Điểm mạnh phù hợp
  personalInfo        String? // Thông tin cá nhân
  githubUrl           String?
  portfolioUrl        String?
  currentCompany      String?
  availability        String? // Thời gian có thể bắt đầu làm việc
  currentSalary       String? // Lức lương hiện tại
  expectedSalary      String? // Mức lương mong muốn
  aiAnalysisSummary        String? // Toàn bộ thông tin phân tích cho AI
  recruiterNotes           String? // Ghi chú HR (markdown): PV, tự đánh giá, metadata bổ sung
  location                 String?
  linkedinConnectionStatus String? // NOT_CONNECTED | PENDING | CONNECTED | UNKNOWN
  matchScore               Int?
  matchSummary             String?
  source                   String? // LINKEDIN_SEARCH | LINKEDIN_INBOX | MANUAL
  linxaChatId              String?
  sentiment                String? // POSITIVE | NEGATIVE | NEUTRAL
  labels                   String? // JSON array of strings
  jobPositionId            String?
  workspaceId              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  jobPosition              JobPosition? @relation(fields: [jobPositionId], references: [id])
  conversations            Conversation[]
}
