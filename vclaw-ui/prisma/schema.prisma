generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./business.sqlite"
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  channel        String // Zalo, Messenger, Telegram
  labels         String? // Chuỗi JSON cho nhãn
  orders         Order[]
  bookings       Booking[]
  conversations  Conversation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Order {
  id                String    @id @default(cuid())
  orderNumber       String    @unique
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  amount            Float
  status            String    // PENDING, PAID, PROCESSING, DONE, FOLLOW_UP
  shippingNote      String?
  shippingEstimate  Float?
  payments          Payment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  amount        Float
  status        String    // PENDING, COMPLETED, FAILED
  evidenceImage String?   // URL ảnh bill
  method        String    // VietQR, Transfer, Cash
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  serviceName  String
  startTime    DateTime
  endTime      DateTime?
  status       String    // PENDING, CONFIRMED, CANCELLED, DONE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Task {
  id        String    @id @default(cuid())
  type      String    // PAYMENT_REVIEW, BOOKING_CONFIRM, SHIPPING_UPDATE, etc.
  title     String
  subtitle  String?
  amount    String?   // Số tiền định dạng sẵn
  isUrgent  Boolean   @default(false)
  status    String    // NEW, DONE, IGNORED
  timeAgo   String?   // Lưu text thời gian từ i18n nếu cần
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?
  imageUrl    String?
  category    String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopSettings {
  id                 String   @id @default("default")
  shopName           String?
  bankQrUrl          String?
  preferredChannel   String?
  bankName           String?
  accountHolder      String?
  accountNumber      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model IntegrationAccount {
  id            String    @id @default(cuid())
  provider      String    @unique
  accountId     String?
  displayName   String?
  avatarUrl     String?
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model IntegrationGroup {
  id          String   @id @default(cuid())
  provider    String   // "zalouser"
  accountId   String?  // Id của tài khoản Zalo sở hữu nhóm
  groupId     String   @unique
  name        String
  memberCount Int?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Danh bạ peer (bạn bè / DM) cache từ `directory.peers.list` — zalouser.
model IntegrationPeer {
  id         String   @id @default(cuid())
  provider   String
  accountId  String?
  /// Mã gửi tin chuẩn kênh, ví dụ `user:3449465574915916286`
  peerId     String
  name       String
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, peerId])
}

/// OAuth / token kênh pilot (local-first; mã hóa field khi triển khai hosted).
model ChannelConnection {
  id               String    @id @default(cuid())
  provider         String    @unique
  appId            String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  externalAccountId String? // OA id / page id
  profileJson      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Luồng hội thoại đồng bộ từ webhook (Zalo OA pilot).
model Conversation {
  id                  String                @id @default(cuid())
  provider            String
  externalThreadId    String
  customerId          String?
  customer            Customer?             @relation(fields: [customerId], references: [id])
  title               String?
  openclawSessionKey  String?
  messages            ConversationMessage[]
  status              String?               // OPEN, CLOSED, ARCHIVED
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([provider, externalThreadId])
  @@index([customerId])
}

model ConversationMessage {
  id                  String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction           String // IN, OUT, SYSTEM
  body                String
  externalMessageId   String?
  rawPayloadJson      String?
  createdAt           DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Nhật ký gọi tool nội bộ (OpenClaw / gateway HTTP → VClaw).
model AgentToolLog {
  id        String   @id @default(cuid())
  tool      String
  payload   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())
}

model AutomationJob {
  id               String   @id @default(cuid())
  title            String
  status           String   @default("QUEUED") // QUEUED, DONE, CANCELLED
  channel          String?
  notes            String?
  draftContent     String?
  /// NONE | PENDING_PUBLISH | APPROVED | REJECTED — bài đăng / outbound cần duyệt
  approvalStatus   String   @default("NONE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
